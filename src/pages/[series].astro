---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { library } from '../data/books';

export function getStaticPaths() {
  return library.map((series) => ({
    params: { series: series.id },
    props: { series },
  }));
}

const { series } = Astro.props;

const PLANNED_BOOK_COUNT = 5;
const showArcBlock = series.books.length < PLANNED_BOOK_COUNT;

const seriesNewsletterBody = "The Council is the series newsletter for readers who want the next book first. Subscribers receive release news for The Hollow Sovereign ahead of the site, cover reveals for Books 3 through 5, and the occasional lore drop, glossary entry, or chapter excerpt that doesn't appear elsewhere.";
---

<Layout title={`S.E. Deracy Official Website | ${series.title}`}>
    <main class="min-h-screen p-8 pt-24 max-w-5xl mx-auto">

        <header class="text-center mb-16">
            <h1 class="heading-hero text-lilac-dark dark:text-gold">{series.title}</h1>
            <p class="text-body max-w-2xl mx-auto text-lg font-bold font-serif text-gray-900 dark:text-white">{series.description}</p>
        </header>

        {series.framingBlock && (
            <section class="mb-16 max-w-3xl mx-auto text-center">
                <div class="h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-void-700 to-transparent mb-12" />
                {series.framingBlock.split('\n\n').filter(p => p.trim()).map((para) => (
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg mb-6 last:mb-0">
                        {para}
                    </p>
                ))}
                <div class="h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-void-700 to-transparent mt-12" />
            </section>
        )}

        <div class="text-center mb-24">
            <a href="/map" class="btn-secondary inline-flex items-center gap-2 text-gray-800 dark:text-white border-gray-900 dark:border-gray-300 dark:hover:border-gold hover:border-lilac">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c-.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                </svg>
                Explore the Map of Eurion
            </a>
        </div>

        <div class="space-y-24">
            {series.books.map((book, index) => (
                <section class={`flex flex-col md:flex-row gap-12 items-start ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>

                    <div class="w-full md:w-1/3 shrink-0">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl border border-gray-200 dark:border-void-700 bg-white dark:bg-void-900 group">
                            {book.cover ? (
                                <img src={book.cover} alt={book.title} class="w-full h-auto object-contain" />
                            ) : (
                                <div class="w-full aspect-[2/3] flex items-end justify-center bg-void-800 p-6">
                                    <span class="text-gold font-serif text-center text-xl leading-snug">{book.title}</span>
                                </div>
                            )}
                        </div>

                        {book.credits && (
                            <div class="mt-6 text-center text-xs text-gray-500 dark:text-gray-600 font-mono uppercase tracking-wider space-y-2">
                                {book.credits.coverArt && (
                                    <p>
                                        <span class="text-gray-400 dark:text-gray-500">Cover art by</span>{' '}
                                        {typeof book.credits.coverArt === 'string' ? (
                                            <span class="text-gray-600 dark:text-gray-400">{book.credits.coverArt}</span>
                                        ) : (
                                            <a href={book.credits.coverArt.url} target="_blank" rel="noopener noreferrer" class="text-lilac-dark dark:text-gold hover:text-black dark:hover:text-white transition border-b border-lilac/30 dark:border-gold/30 hover:border-black dark:hover:border-white">
                                                {book.credits.coverArt.name}
                                            </a>
                                        )}
                                    </p>
                                )}
                                {book.credits.editing && (
                                    <p>
                                        <span class="text-gray-400 dark:text-gray-500">Edited by</span>{' '}
                                        {typeof book.credits.editing === 'string' ? (
                                            <span class="text-gray-600 dark:text-gray-400">{book.credits.editing}</span>
                                        ) : (
                                            <a href={book.credits.editing.url} target="_blank" rel="noopener noreferrer" class="text-lilac-dark dark:text-gold hover:text-black dark:hover:text-white transition border-b border-lilac/30 dark:border-gold/30 hover:border-black dark:hover:border-white">
                                                {book.credits.editing.name}
                                            </a>
                                        )}
                                    </p>
                                )}
                                {book.credits.typography && (
                                    <p>
                                        <span class="text-gray-400 dark:text-gray-500">Formatted by</span>{' '}
                                        {typeof book.credits.typography === 'string' ? (
                                            <span class="text-gray-600 dark:text-gray-400">{book.credits.typography}</span>
                                        ) : (
                                            <a href={book.credits.typography.url} target="_blank" rel="noopener noreferrer" class="text-lilac-dark dark:text-gold hover:text-black dark:hover:text-white transition border-b border-lilac/30 dark:border-gold/30 hover:border-black dark:hover:border-white">
                                                {book.credits.typography.name}
                                            </a>
                                        )}
                                    </p>
                                )}
                            </div>
                        )}
                    </div>

                    <div class="w-full md:w-2/3 text-center md:text-left">
                        <span class="text-gray-900 dark:text-white font-bold tracking-widest text-sm uppercase mb-2 block">
                            {book.isReleased ? 'Available Now' : book.releaseDate}
                        </span>
                        <h2 class="text-4xl font-serif text-lilac-dark dark:text-gold mb-4">Book {index + 1}: {book.title}</h2>
                        <div class="text-gray-600 dark:text-gray-400 leading-relaxed mb-8 text-lg">
                            {book.description.split('\n\n').filter(p => p.trim()).map((para) => (
                                <p class="mb-4 last:mb-0">{para}</p>
                            ))}
                        </div>

                        <div>
                            {book.isReleased ? (
                                <a href={book.amazonLink} target="_blank" rel="noopener noreferrer" class="btn-primary bg-lilac-dark dark:bg-gold text-white dark:text-void-900 hover:opacity-90 border-none inline-block px-8">
                                    Buy on Amazon
                                </a>
                            ) : (
                                <button disabled class="px-8 py-3 rounded-lg font-sans font-medium text-gray-400 dark:text-gray-500 border border-gray-300 dark:border-gray-700 cursor-not-allowed bg-gray-100 dark:bg-void-800">
                                    Coming Soon
                                </button>
                            )}
                        </div>
                    </div>
                </section>
            ))}
        </div>

        {showArcBlock && (
            <section class="mt-24">
                <div class="card-glass max-w-2xl mx-auto text-center px-8 py-12">
                    <span class="text-lilac-dark dark:text-gold font-bold tracking-[0.2em] text-xs uppercase mb-4 block">
                        Books III — V
                    </span>
                    <div class="h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-void-700 to-transparent mb-8" />
                    <h3 class="text-2xl font-serif text-gray-900 dark:text-white mb-6">The arc continues.</h3>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
                        The Elementless Magician is a planned five-book series. The arc is fully mapped through Book 5, with the ending already in place.
                    </p>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                        Sequel titles, covers, and release windows will be announced through the Inner Circle.
                    </p>
                </div>
            </section>
        )}

    </main>

    <Newsletter body={seriesNewsletterBody} />
</Layout>
